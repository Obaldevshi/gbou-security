[Unit]
Description=GBOU lightweight guard kiosk
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=/opt/gbou-kiosk
EnvironmentFile=-/etc/gbou-kiosk.conf
ExecStart=/usr/bin/python3 /opt/gbou-kiosk/server.py
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/gbou-kiosk
ReadWritePaths=/var/lib/gbou-kiosk
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
