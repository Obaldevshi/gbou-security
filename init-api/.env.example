# Database
DATABASE_URL=postgresql://postgres:password@db:5432/backend_template

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=Backend Template API
APP_VERSION=1.0.0
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.twc1\.net$
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# One-time super administrator recovery. Change RESET_ID for every new reset.
# Remove both variables after the recovered account has changed its password.
# SUPERADMIN_RESET_PASSWORD=TemporaryPassword123
# SUPERADMIN_RESET_ID=2026-08-23-recovery-1

# Backups (mount this directory to persistent/object storage in production)
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
