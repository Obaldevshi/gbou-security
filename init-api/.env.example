# Database
DATABASE_URL=postgresql://postgres:password@db:5432/backend_template
DEPLOYMENT_MODE=legacy
MIGRATION_FREEZE_WRITES=false
SCHOOL_DEVICES_ENABLED=false
# Staged campus mode: migration 016 + compatible app/Pi + registry preflight first.
# Do NOT turn on just because the source code has been deployed.
BUILDING_NODES_ENABLED=false
# Local Pi ONLY, assigned from its verified QR enrollment; no shared school DB.
# GBOU_BUILDING_ID=1
DEVICE_PAIRING_ENABLED=false
SCHOOL_DOMAIN=gbousecurity.ru
# Enable only after migration 011 and separate gateway/DNS approval.
# SHA256 of a dedicated read-only manifest key, not the node sync key.
GATEWAY_MANIFEST_TOKEN_HASH=
GATEWAY_PUBLIC_KEY=
GATEWAY_ENDPOINT=

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TRUSTED_DEVICE_EXPIRE_DAYS=30

# Application
APP_NAME=Backend Template API
APP_VERSION=1.0.0
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.twc1\.net$

# Backups (mount this directory to persistent/object storage in production)
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
## Optional login-to-school routing. Separate random secret, never a JWT/device key.
LOGIN_DIRECTORY_ENABLED=false
LOGIN_DIRECTORY_PEPPER=
